; Firetender - Phase 1
config_version=5

[application]
config/name="Firetender | The Living Fire"
run/main_scene="res://hearth/launch.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=820
window/size/window_width_override=1152
window/size/window_height_override=738
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.047, 0.041, 1)
