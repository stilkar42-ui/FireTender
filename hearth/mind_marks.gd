const DOTS := {"kin": [Vector2(0, -12)], "caution": [Vector2(0, 6)]}

static func paint(canvas: CanvasItem, symbol: String, at: Vector2, factor: float, ink: Color) -> void:
	for stroke: Array in STROKES.get(symbol, []):
		var points := PackedVector2Array()
		for i in range(0, stroke.size(), 2):
			points.append(at + Vector2(stroke[i], stroke[i + 1]) * factor)
		canvas.draw_polyline(points, ink, maxf(1.4, 2.35 * factor), true)
		for point in [points[0], points[-1]]:
			canvas.draw_circle(point, maxf(0.7, 1.05 * factor), ink, true, -1.0, true)
	for dot: Vector2 in DOTS.get(symbol, []):
		canvas.draw_circle(at + dot * factor, maxf(1.3, 2.45 * factor), ink, true, -1.0, true)
